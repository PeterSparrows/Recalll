# Dependencies — huge, and regenerated by npm install / pip install
node_modules/
venv/
__pycache__/
*.pyc

# Secrets — NEVER upload these
.env
*.env
!.env.example

# Runtime data — not source code
backend/uploads/*
!backend/uploads/.gitkeep
ai-service/vector_stores/*
!ai-service/vector_stores/.gitkeep

# OS / editor junk
*.log
.DS_Store
Thumbs.db
.vscode/