# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
# Local: mongodb://127.0.0.1:27017/learning_assessment_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/learning_assessment_db
MONGO_URI=mongodb://127.0.0.1:27017/learning_assessment_db

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
RESET_TOKEN_EXPIRES_MINUTES=30

# Email (used for password reset links)
# Gmail SMTP: enable 2-Step Verification on your Google account, then
# create an "App Password" at myaccount.google.com/apppasswords — use
# that as EMAIL_PASS, NOT your normal Gmail password.
# Leave EMAIL_USER/EMAIL_PASS blank to skip real sending in local dev —
# forgot-password will log to the console and return the token directly
# in the API response instead (see auth.controller.js).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Recall <your.email@gmail.com>"

# AI microservice (internal only — never exposed to the browser)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=60000

# Uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10
